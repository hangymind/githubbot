# Copy to .env. Fill real values ONLY on your server.
QQ_APP_ID=1906010968
QQ_APP_SECRET=
GITHUB_REPOSITORY=owner/private-repository
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
DATABASE_PATH=./data/qbot.sqlite3
HOST=127.0.0.1
PORT=8000
# Keep false unless the QQ platform permits commit URLs.
INCLUDE_COMMIT_URL=false
# Must be >= 4. Conservative for a single group and an unverified bot.
SEND_INTERVAL_SECONDS=4
# sandbox is only for a bot explicitly configured for the sandbox environment.
QQ_ENVIRONMENT=production
